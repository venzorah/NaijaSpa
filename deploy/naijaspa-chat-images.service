[Unit]
Description=Remove expired NaijaSpa booking chat photos
After=naijaspa-web.service

[Service]
Type=oneshot
User=naijaspa
Group=naijaspa
WorkingDirectory=/srv/naijaspa/current
EnvironmentFile=/srv/naijaspa/shared/.env
ExecStart=/usr/bin/node /srv/naijaspa/current/deploy/run-chat-images.mjs
TimeoutStartSec=65
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
