generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  googleId           String?   @unique
  name               String
  phone              String?
  phoneNormalized    String?   @unique
  phoneVerifiedAt    DateTime?
  accountKind        String    @default("registered")
  locale             String    @default("en")
  theme              String?
  role               String
  status             String    @default("active")
  emailVerifiedAt    DateTime?
  deletionRequestedAt DateTime?
  notificationPreferencesJson String @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           Session[]
  passwordResets     PasswordReset[]
  vendorOwned        Vendor?               @relation("VendorOwner")
  staffMemberships   VendorStaff[]
  customerProfile    CustomerProfile?
  bookings           Booking[]
  bookingMessages    BookingMessage[]
  reviews            Review[]
  favourites         Favourite[]
  tickets            SupportTicket[]       @relation("TicketAuthor")
  assignedTickets    SupportTicket[]       @relation("TicketAssignee")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  memberships        CustomerMembership[]
  auditLogs          AuditLog[]
  invitesSent        VendorInvite[]        @relation("InviteSender")
  listingClicks      AdminListingClick[]
  shopCarts          ShopCart[]
  shopMasterOrders   ShopMasterOrder[]
  shopReviews        ShopReview[]
  shopReturns        ShopReturn[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  failedAttempts Int @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PhoneOtpChallenge {
  id              String   @id @default(cuid())
  phoneNormalized String
  purpose         String
  token           String
  expiresAt       DateTime
  failedAttempts  Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([phoneNormalized, createdAt])
}

model CustomerProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  city         String?
  neighbourhood String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id                   String    @id @default(cuid())
  ownerId              String    @unique
  slug                 String    @unique
  businessName         String
  providerType         String    @default("spa")
  description          String    @default("")
  logoUrl              String?
  coverUrl             String?
  galleryJson          String    @default("[]")
  state                String    @default("Lagos")
  city                 String
  neighbourhood        String
  address              String
  coverageJson         String    @default("[]")
  amenitiesJson        String    @default("[]")
  hoursJson            String    @default("{}")
  privatePhone         String?
  privateWhatsapp      String?
  instagramUrl         String?
  publicContactEnabled Boolean   @default(false)
  payoutBankCode       String?
  payoutBankName       String?
  payoutAccountNumber  String?
  payoutAccountName    String?
  payoutRecipientCode  String?
  cancellationPolicy   String    @default("")
  applicationStatus    String    @default("draft")
  verificationStatus   String    @default("unverified")
  visibility           String    @default("hidden")
  suspendedAt          DateTime?
  ratingAvg            Float     @default(0)
  reviewCount          Int       @default(0)
  publicViewCount      Int       @default(0)
  publicClickCount     Int       @default(0)
  adminClickCount      Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner                User              @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  slugAliases          VendorSlugAlias[]
  staff                VendorStaff[]
  services             Service[]
  documents            VerificationDoc[]
  subscriptions        VendorSubscription[]
  bookings             Booking[]
  campaigns            Campaign[]
  payouts              Payout[]
  earnings             VendorEarning[]
  invites              VendorInvite[]
  galleries            TherapistGallery[]
  videoLinks           VendorVideoLink[]
  heroAds              HeroAd[]
  adminClicks          AdminListingClick[]
  listingHits          ListingHit[]
  commerceKind         String    @default("services")
  shopStatus           String    @default("none")
  shopNote             String    @default("")
  shopRejectedReason   String    @default("")
  shopPlans            ShopVendorSubscription[]
  shopProducts         ShopProduct[]
  shopShipping         ShopShippingProfile?
  shopVendorOrders     ShopVendorOrder[]
  shopLedger           ShopLedgerEntry[]
  shopSettlements      ShopSettlement[]
  shopPayouts          ShopPayout[]
  shopPromotions       ShopPromotion[]
}

model ListingHit {
  id        String   @id @default(cuid())
  vendorId  String
  serviceId String?
  kind      String
  channel   String
  source    String   @default("")
  medium    String   @default("")
  campaign  String   @default("")
  content   String   @default("")
  term      String   @default("")
  path      String   @default("")
  referrer  String   @default("")
  ipHash    String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([serviceId, createdAt])
  @@index([kind, channel, createdAt])
}

model AdminListingClick {
  id        String   @id @default(cuid())
  vendorId  String
  actorId   String
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@index([actorId])
}

model VendorSlugAlias {
  slug      String @id
  vendorId  String
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model TherapistGallery {
  id        String   @id @default(cuid())
  vendorId  String
  title     String
  caption   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  images    TherapistGalleryImage[]

  @@index([vendorId])
}

model TherapistGalleryImage {
  id             String           @id @default(cuid())
  galleryId      String
  url            String
  caption        String           @default("")
  therapistName  String           @default("")
  byteSize       Int              @default(0)
  payload        Bytes?
  mimeType       String           @default("")
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  gallery        TherapistGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
}

model VendorVideoLink {
  id        String   @id @default(cuid())
  vendorId  String
  url       String
  title     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorInvite {
  id          String    @id @default(cuid())
  vendorId    String?
  email       String
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InviteSender", fields: [invitedById], references: [id])
}

model VendorStaff {
  id        String  @id @default(cuid())
  vendorId  String
  userId    String?
  name      String
  gender    String  @default("")
  title     String?
  bio       String?
  photoUrl  String?
  active    Boolean @default(true)
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id])
  services  ServiceStaff[]
  slots     AvailabilitySlot[]
  bookings  Booking[]

  @@index([vendorId])
}

model VerificationDoc {
  id           String   @id @default(cuid())
  vendorId     String
  kind         String
  filePath     String
  mimeType     String   @default("")
  byteSize     Int      @default(0)
  imagePayload Bytes?
  status       String   @default("submitted")
  notes        String?
  createdAt    DateTime @default(now())
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, kind])
}

model Category {
  deletedAt       DateTime?
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  synonyms        String    @default("")
  description     String    @default("")
  metaTitle       String    @default("")
  metaDescription String    @default("")
  imageUrl        String?
  imagePayload    Bytes?
  imageMime       String    @default("")
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  archivedAt      DateTime?
  services        Service[]
}

model Service {
  deletedAt            DateTime?
  id                   String   @id @default(cuid())
  vendorId             String
  categoryId           String
  slug                 String   @unique
  name                 String
  description          String   @default("")
  imageUrl             String?
  basePriceKobo        Int
  durationMin          Int
  active               Boolean  @default(true)
  spaEnabled           Boolean  @default(true)
  hotelEnabled         Boolean  @default(true)
  homeEnabled          Boolean  @default(true)
  hotelAddonKobo       Int      @default(0)
  homeAddonKobo        Int      @default(0)
  cancellationRules    String   @default("")
  publicViewCount      Int      @default(0)
  publicClickCount     Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  vendor               Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category             Category @relation(fields: [categoryId], references: [id])
  addons               ServiceAddon[]
  staff                ServiceStaff[]
  bookings             Booking[]
  favourites           Favourite[]
  campaigns            Campaign[]
  slugAliases          ServiceSlugAlias[]
  listingHits          ListingHit[]

  @@index([vendorId, active])
}

model ServiceSlugAlias {
  slug        String   @id
  serviceId   String
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAddon {
  id          String  @id @default(cuid())
  serviceId   String
  name        String
  priceKobo   Int
  durationMin Int     @default(0)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceStaff {
  serviceId String
  staffId   String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     VendorStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
}

model AvailabilitySlot {
  id        String      @id @default(cuid())
  vendorId  String
  staffId   String?
  weekday   Int
  startMin  Int
  endMin    Int
  bufferMin Int         @default(15)
  staff     VendorStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([vendorId, weekday])
}

model TimeOff {
  id        String   @id @default(cuid())
  staffId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
}

model SubscriptionPlan {
  id                 String  @id @default(cuid())
  code               String  @unique
  name               String
  durationDays       Int
  priceKobo          Int
  commissionBps      Int
  publicDirectContact Boolean @default(false)
  enhancedVisibility Boolean @default(false)
  sponsoredEligible  Boolean @default(false)
  unlimitedListings  Boolean @default(true)
  active             Boolean @default(true)
  subscriptions      VendorSubscription[]
}

model VendorSubscription {
  id            String    @id @default(cuid())
  vendorId      String
  planId        String
  status        String
  source        String
  startsAt      DateTime
  endsAt        DateTime
  cancelAtPeriodEnd Boolean @default(false)
  graceUntil    DateTime?
  createdAt     DateTime  @default(now())
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  bookings      Booking[]

  @@index([vendorId, status])
}

model MediaAsset {
  deletedAt    DateTime?
  storageCleanupPending Boolean @default(false)
  id           String   @id @default(cuid())
  url          String   @unique
  name         String
  mime         String
  byteSize     Int
  imagePayload Bytes?
  createdById  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([storageCleanupPending, deletedAt])
}

model SystemConfig {
  key   String @id
  value String
}

model HomeHero {
  id        String   @id @default("home")
  kicker    String
  title     String
  subtitle  String   @default("")
  priceLine String   @default("")
  ctaLabel  String
  ctaHref   String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroAd {
  id        String   @id @default(cuid())
  vendorId  String?
  title     String
  body      String   @default("")
  imageUrl  String
  ctaLabel  String   @default("View vendor")
  ctaHref   String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder])
  @@index([vendorId])
}

model Booking {
  id                    String   @id @default(cuid())
  customerId            String
  vendorId              String
  serviceId             String
  staffId               String?
  locationType          String
  locationDetails       String   @default("")
  customerNotes         String   @default("")
  startsAt              DateTime
  endsAt                DateTime
  timezone              String   @default("Africa/Lagos")
  status                String
  currency              String   @default("NGN")
  basePriceKobo         Int
  surchargeKobo         Int
  discountKobo          Int      @default(0)
  feesKobo              Int      @default(0)
  commissionBps         Int
  commissionKobo        Int
  customerTotalKobo     Int
  vendorPayableKobo     Int
  surchargeRecipient    String
  subscriptionId        String?
  planCodeSnapshot      String
  idempotencyKey        String   @unique
  cancelReason          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customer              User     @relation(fields: [customerId], references: [id])
  vendor                Vendor   @relation(fields: [vendorId], references: [id])
  service               Service  @relation(fields: [serviceId], references: [id])
  staff                 VendorStaff? @relation(fields: [staffId], references: [id])
  subscription          VendorSubscription? @relation(fields: [subscriptionId], references: [id])
  payments              Payment[]
  refunds               Refund[]
  earning               VendorEarning?
  review                Review?
  statusHistory         BookingStatusEvent[]
  messages              BookingMessage[]

  @@index([vendorId, startsAt])
  @@index([customerId, status])
  @@index([staffId, startsAt])
}

model BookingMessage {
  id             String    @id @default(cuid())
  bookingId      String
  senderId       String
  body           String    @default("")
  imageMime      String    @default("")
  imagePayload   Bytes?
  imageExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender         User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([imageExpiresAt])
}

model BookingStatusEvent {
  id        String   @id @default(cuid())
  bookingId String
  fromStatus String?
  toStatus  String
  actorId   String?
  note      String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  bookingId              String?
  membershipId           String?
  subscriptionId         String?
  shopMasterOrderId      String?
  shopVendorSubscriptionId String?
  provider        String
  purpose         String
  amountKobo      Int
  currency        String   @default("NGN")
  status          String
  reference       String   @unique
  providerRef     String?
  idempotencyKey  String   @unique
  rawPayload      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking? @relation(fields: [bookingId], references: [id])
  shopMasterOrder ShopMasterOrder? @relation(fields: [shopMasterOrderId], references: [id])
  shopVendorSubscription ShopVendorSubscription? @relation(fields: [shopVendorSubscriptionId], references: [id])
  refunds         Refund[]
}

model Refund {
  id          String    @id @default(cuid())
  paymentId   String
  bookingId   String?
  amountKobo  Int
  penaltyKobo Int       @default(0)
  reason      String?
  status      String
  providerRef String?
  rawPayload  String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  payment     Payment   @relation(fields: [paymentId], references: [id])
  booking     Booking?  @relation(fields: [bookingId], references: [id])
}

model VendorEarning {
  id            String  @id @default(cuid())
  vendorId      String
  bookingId     String  @unique
  payableKobo   Int
  commissionKobo Int
  surchargeKobo Int
  status        String  @default("pending")
  vendor        Vendor  @relation(fields: [vendorId], references: [id])
  booking       Booking @relation(fields: [bookingId], references: [id])
  payout        Payout?
}

model Payout {
  id          String   @id @default(cuid())
  vendorId    String
  earningId   String?  @unique
  amountKobo  Int
  status      String
  note        String?
  reference   String?
  providerRef String?
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  earning     VendorEarning? @relation(fields: [earningId], references: [id])
}

model MembershipPlan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  interval    String
  priceKobo   Int
  benefits    String
  active      Boolean  @default(true)
  memberships CustomerMembership[]
}

model CustomerMembership {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  status    String
  startsAt  DateTime
  endsAt    DateTime
  user      User     @relation(fields: [userId], references: [id])
  plan      MembershipPlan @relation(fields: [planId], references: [id])
}

model Promotion {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  percentOff  Int      @default(0)
  amountKobo  Int      @default(0)
  startsAt    DateTime
  endsAt      DateTime
  maxRedemptions Int?
  usedCount   Int      @default(0)
  active      Boolean  @default(true)
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String   @id @default(cuid())
  promotionId String
  userId      String
  bookingId   String?
  createdAt   DateTime @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  userId     String
  vendorId   String
  rating     Int
  body       String
  status     String   @default("published")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  booking    Booking  @relation(fields: [bookingId], references: [id])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String?
  serviceId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id])

  @@unique([userId, vendorId, serviceId])
  @@unique([userId, serviceId])
}

model Campaign {
  id          String   @id @default(cuid())
  vendorId    String
  serviceId   String?
  placement   String
  startsAt    DateTime
  endsAt      DateTime
  priority    Int      @default(0)
  active      Boolean  @default(true)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])
}

model CmsBlock {
  id              String  @id @default(cuid())
  key             String  @unique
  title           String
  body            String
  metaTitle       String  @default("")
  metaDescription String  @default("")
  locale          String  @default("en")
  published       Boolean @default(true)
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model SupportTicket {
  id          String   @id @default(cuid())
  authorId    String
  assigneeId  String?
  subject     String
  status      String   @default("open")
  internalNotes String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation("TicketAuthor", fields: [authorId], references: [id])
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  actionUrl String @default("/account/bookings")
  pushStatus String @default("pending")
  pushAttempts Int @default(0)
  pushClaimedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pushStatus, createdAt])
}

model PushSubscription {
  id        String @id @default(cuid())
  userId    String
  endpoint  String @unique
  p256dh    String
  auth      String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
}

model AiSearchLog {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  filtersJson  String
  resultCount  Int
  usedFallback Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ShopPlan {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  durationDays   Int
  priceKobo      Int
  commissionBps  Int
  featuredBoost  Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscriptions  ShopVendorSubscription[]
}

model ShopVendorSubscription {
  id        String   @id @default(cuid())
  vendorId  String
  planId    String
  status    String
  source    String   @default("system")
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan      ShopPlan @relation(fields: [planId], references: [id])
  payments  Payment[]

  @@index([vendorId, status])
}

model ShopCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  parentId    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  parent      ShopCategory?  @relation("ShopCategoryTree", fields: [parentId], references: [id])
  children    ShopCategory[] @relation("ShopCategoryTree")
  products    ShopProduct[]

  @@index([parentId, sortOrder])
}

model ShopProduct {
  id             String   @id @default(cuid())
  vendorId       String
  categoryId     String
  slug           String   @unique
  name           String
  description    String   @default("")
  ingredients    String   @default("")
  usage          String   @default("")
  warnings       String   @default("")
  expiryNote     String   @default("")
  nafdacNumber   String   @default("")
  status         String   @default("draft")
  featured       Boolean  @default(false)
  sponsoredUntil DateTime?
  ratingAvg      Float    @default(0)
  reviewCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category       ShopCategory @relation(fields: [categoryId], references: [id])
  images         ShopProductImage[]
  variants       ShopProductVariant[]
  reviews        ShopReview[]
  cartItems      ShopCartItem[]
  orderItems     ShopOrderItem[]
  promotions     ShopPromotion[]

  @@index([vendorId, status])
  @@index([categoryId, status])
}

model ShopProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ShopProductVariant {
  id             String  @id @default(cuid())
  productId      String
  sku            String
  name           String  @default("Default")
  priceKobo      Int
  compareKobo    Int     @default(0)
  stockOnHand    Int     @default(0)
  reserved       Int     @default(0)
  active         Boolean @default(true)
  product        ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryTxns  ShopInventoryTxn[]
  cartItems      ShopCartItem[]
  orderItems     ShopOrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ShopInventoryTxn {
  id         String   @id @default(cuid())
  variantId  String
  kind       String
  quantity   Int
  refType    String   @default("")
  refId      String   @default("")
  createdAt  DateTime @default(now())
  variant    ShopProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([kind, refType, refId, variantId])
  @@index([variantId, createdAt])
}

model ShopShippingProfile {
  id              String  @id @default(cuid())
  vendorId        String  @unique
  localEnabled    Boolean @default(true)
  localFeeKobo    Int     @default(0)
  localEtaDays    Int     @default(2)
  interstateOn    Boolean @default(false)
  pickupEnabled   Boolean @default(false)
  freeAboveKobo   Int     @default(0)
  vendor          Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zones           ShopShippingZone[]
}

model ShopShippingZone {
  id         String @id @default(cuid())
  profileId  String
  state      String
  feeKobo    Int
  etaDays    Int    @default(5)
  profile    ShopShippingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, state])
}

model ShopCart {
  id        String   @id @default(cuid())
  userId    String?
  guestKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShopCartItem[]

  @@index([userId])
  @@index([guestKey])
}

model ShopCartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  cart      ShopCart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   ShopProduct         @relation(fields: [productId], references: [id])
  variant   ShopProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model ShopMasterOrder {
  id                 String   @id @default(cuid())
  number             String   @unique
  userId             String?
  email              String
  name               String
  phone              String   @default("")
  address            String
  city               String
  state              String
  neighbourhood      String   @default("")
  status             String   @default("pending_payment")
  productKobo        Int
  shippingKobo       Int
  totalKobo          Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User?    @relation(fields: [userId], references: [id])
  vendorOrders       ShopVendorOrder[]
  payments           Payment[]
  returns            ShopReturn[]
}

model ShopVendorOrder {
  id                 String   @id @default(cuid())
  masterOrderId      String
  vendorId           String
  number             String   @unique
  status             String   @default("pending_payment")
  productKobo        Int
  shippingKobo       Int
  commissionBps      Int
  commissionKobo     Int
  vendorPayableKobo  Int
  planCodeSnapshot   String
  tracking           String   @default("")
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  master             ShopMasterOrder @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  vendor             Vendor          @relation(fields: [vendorId], references: [id])
  items              ShopOrderItem[]
  ledger             ShopLedgerEntry[]
  settlement         ShopSettlement?
  returns            ShopReturn[]

  @@index([vendorId, status])
  @@index([masterOrderId])
}

model ShopOrderItem {
  id            String @id @default(cuid())
  vendorOrderId String
  productId     String
  variantId     String
  nameSnapshot  String
  skuSnapshot   String
  quantity      Int
  unitKobo      Int
  lineKobo      Int
  vendorOrder   ShopVendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product       ShopProduct        @relation(fields: [productId], references: [id])
  variant       ShopProductVariant @relation(fields: [variantId], references: [id])
}

model ShopLedgerEntry {
  id            String   @id @default(cuid())
  vendorId      String
  vendorOrderId String?
  kind          String
  amountKobo    Int
  note          String   @default("")
  createdAt     DateTime @default(now())
  vendor        Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorOrder   ShopVendorOrder? @relation(fields: [vendorOrderId], references: [id])

  @@index([vendorId, createdAt])
}

model ShopSettlement {
  id            String    @id @default(cuid())
  vendorId      String
  vendorOrderId String    @unique
  amountKobo    Int
  status        String    @default("pending")
  availableAt   DateTime
  paidAt        DateTime?
  payoutId      String?
  createdAt     DateTime  @default(now())
  vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorOrder   ShopVendorOrder @relation(fields: [vendorOrderId], references: [id])
  payout        ShopPayout?     @relation(fields: [payoutId], references: [id])

  @@index([vendorId, status])
}

model ShopPayout {
  id          String   @id @default(cuid())
  vendorId    String
  amountKobo  Int
  status      String
  reference   String   @unique
  providerRef String?
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  settlements ShopSettlement[]
}

model ShopReturn {
  id            String   @id @default(cuid())
  masterOrderId String
  vendorOrderId String
  userId        String
  reason        String
  evidenceUrl   String   @default("")
  status        String   @default("open")
  refundKobo    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  master        ShopMasterOrder @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  vendorOrder   ShopVendorOrder @relation(fields: [vendorOrderId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@index([vendorOrderId, status])
}

model ShopReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  body      String   @default("")
  status    String   @default("published")
  createdAt DateTime @default(now())
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
}

model ShopPromotion {
  id        String   @id @default(cuid())
  vendorId  String?
  productId String?
  kind      String
  label     String
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  vendor    Vendor?      @relation(fields: [vendorId], references: [id])
  product   ShopProduct? @relation(fields: [productId], references: [id])

  @@index([kind, active, startsAt])
}
