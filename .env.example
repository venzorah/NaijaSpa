# Database — SQLite works locally. For PostgreSQL set a postgres:// URL and change prisma/schema.prisma provider.
DATABASE_URL="file:./dev.db"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"

# Payments (server-side only). Leave empty to keep Paystack in structured-but-unconfigured mode.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Optional Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI search (server-side only). App falls back to a local structured parser if unset.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Web push (optional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:concierge@naijaspa.ng"

# Cron / internal jobs
INTERNAL_JOB_SECRET="replace-with-job-secret"
