# PostgreSQL (required for real bookings, auth and admin).
# Local Docker: postgresql://naijaspa:naijaspa@localhost:5432/naijaspa
# Vercel: Neon / Supabase / RDS connection string.
# If this is unset on Vercel, public pages keep bundled demo listings until you add Postgres.
DATABASE_URL="postgresql://naijaspa:naijaspa@localhost:5432/naijaspa"
# USE_DEMO_LISTINGS="true"   # force demo catalog even with Postgres
# USE_DEMO_LISTINGS="false"  # force Prisma even if DATABASE_URL looks empty

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"
# Google / Gmail sign-in (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack (NGN, amounts in kobo). Secret stays server-side. Public key is only for Inline.
# Test keys from https://dashboard.paystack.com/#/settings/developer
# Dashboard webhook URL: https://naijaspa.ng/api/payments/webhook  (event: charge.success)
# Leave empty locally to record initialized payments without charging.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Optional. If unset, webhook HMAC uses PAYSTACK_SECRET_KEY (Paystack default).
PAYSTACK_WEBHOOK_SECRET=""

# AI search (server-side only). App falls back to a local structured parser if unset.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Web push (optional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:concierge@naijaspa.ng"

# Cron / internal jobs
INTERNAL_JOB_SECRET="replace-with-job-secret"
