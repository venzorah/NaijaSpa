# PostgreSQL (required for real bookings, auth and admin).
# Local Docker — set BOTH to the same URL:
DATABASE_URL="postgresql://naijaspa:naijaspa@localhost:5432/naijaspa"
DIRECT_URL="postgresql://naijaspa:naijaspa@localhost:5432/naijaspa"
# Production (Vercel → Supabase). Transaction pooler (6543) + session/direct (5432).
# See docs/SUPABASE.md
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# If DATABASE_URL is unset, public pages keep bundled demo listings.
# USE_DEMO_LISTINGS="true"   # force demo catalog even with Postgres
# USE_DEMO_LISTINGS="false"  # force Prisma even if DATABASE_URL looks empty

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"
# Google / Gmail sign-in (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Web client. Authorized JavaScript origins:
#   https://www.naijaspa.com  https://naijaspa.com  https://www.naijaspa.ng  https://naijaspa.ng  http://localhost:3000
# Authorized redirect URIs (all of them):
#   https://www.naijaspa.com/api/auth/google/callback
#   https://naijaspa.com/api/auth/google/callback
#   https://www.naijaspa.ng/api/auth/google/callback
#   https://naijaspa.ng/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional extra origins (comma-separated) for Vercel previews
# GOOGLE_REDIRECT_ORIGINS="https://naijaspa.vercel.app"

# Paystack (NGN, amounts in kobo). Secret stays server-side. Public key is only for Inline.
# Test keys from https://dashboard.paystack.com/#/settings/developer
# Dashboard webhook URL: https://naijaspa.com/api/payments/webhook  (event: charge.success)
# Leave empty locally to record initialized payments without charging.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Optional. If unset, webhook HMAC uses PAYSTACK_SECRET_KEY (Paystack default).
PAYSTACK_WEBHOOK_SECRET=""

# AI search (server-side only). App falls back to a local structured parser if unset.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Transactional email (welcome + password reset). From address is always admin@naijaspa.ng unless MAIL_FROM is set.
MAIL_FROM="NaijaSpa <admin@naijaspa.ng>"
# Option A — SMTP (cPanel / Google Workspace / any host that can send as admin@naijaspa.ng)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Option B — Resend (https://resend.com). Domain naijaspa.ng must be verified.
RESEND_API_KEY=""

# Web push (optional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:concierge@naijaspa.com"

# Cron / internal jobs
INTERNAL_JOB_SECRET="replace-with-job-secret"
